PORT=5000
NODE_ENV=development

# Supabase database connection string (Project > Connect).
# Special characters in the password (@ : / # ? % etc.) must be percent-encoded here.
DATABASE_URL=postgresql://postgres:PASSWORD@db.oxbrsxirkmhwpooilnll.supabase.co:5432/postgres

# any long random string, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# bcrypt cost for password hashing (default 10)
SALT=10

# comma-separated list of frontend URLs allowed to call the API
ALLOWED_ORIGINS=http://localhost:5173
